{
  "name": "pnpm-release-action",
  "version": "0.2.2",
  "private": true,
  "description": "CI layer for pnpm built-in versioning: release PRs, tags, and GitHub Releases",
  "keywords": [],
  "homepage": "https://github.com/k35o/pnpm-release-action#readme",
  "bugs": "https://github.com/k35o/pnpm-release-action/issues",
  "license": "MIT",
  "author": "k8o (https://github.com/k35o)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/pnpm-release-action.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "check:write": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@k8o/oxc-config": "1.1.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
